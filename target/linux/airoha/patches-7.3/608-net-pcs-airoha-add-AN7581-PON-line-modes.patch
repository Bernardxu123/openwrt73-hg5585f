+/* PON PMA electrical interface registers used by phy_trans_model_setting(). */
+#define AIROHA_PCS_PMA_XPON_SETTING_0	0x270
+#define AIROHA_PCS_PMA_XPON_SETTING_1	0x274
+
+int airoha_pcs_pon_config_rx(struct phylink_pcs *pcs,
+			     enum airoha_pcs_pon_mode mode,
+			     u32 xpon_setting0, u32 xpon_setting1)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	phy_interface_t rx_interface;
+	u32 wan_sel, xsi_sel;
+	int ret;
+
+	if (!pcs)
+		return -EINVAL;
+
+	port = to_airoha_pcs_port(pcs);
+	priv = port->priv;
+
+	/* DTS and SoC match data provide the AN7581 and AN7583 register windows. */
+	if (priv->data->port_type != AIROHA_PCS_PON)
+		return -EOPNOTSUPP;
+
+	switch (mode) {
+	case AIROHA_PCS_PON_MODE_GPON:
+		/* WAN_SEL 0 selects the 2.48832G RX path over HSGMII. */
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 0);
+		xsi_sel = AIROHA_SCU_PON_XSI_HSGMII;
+		rx_interface = PHY_INTERFACE_MODE_2500BASEX;
+		break;
+	case AIROHA_PCS_PON_MODE_XGPON:
+		/* WAN_SEL 9 selects the 9.95328G XG-PON downstream path. */
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 9);
+		xsi_sel = AIROHA_SCU_PON_XSI_USXGMII;
+		rx_interface = PHY_INTERFACE_MODE_10GBASER;
+		break;
+	case AIROHA_PCS_PON_MODE_XGSPON:
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 10);
+		xsi_sel = AIROHA_SCU_PON_XSI_USXGMII;
+		rx_interface = PHY_INTERFACE_MODE_10GBASER;
+		break;
+	case AIROHA_PCS_PON_MODE_EPON_1G:
+		/* XEPON_1G combines the 10G MAC with the 1.25G EPON PHY. */
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 8);
+		xsi_sel = AIROHA_SCU_PON_XSI_USXGMII;
+		rx_interface = PHY_INTERFACE_MODE_1000BASEX;
+		break;
+	case AIROHA_PCS_PON_MODE_EPON_10G_1G:
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 6);
+		xsi_sel = AIROHA_SCU_PON_XSI_USXGMII;
+		rx_interface = PHY_INTERFACE_MODE_10GBASER;
+		break;
+	case AIROHA_PCS_PON_MODE_EPON_10G_10G:
+		wan_sel = FIELD_PREP(AIROHA_SCU_WAN_SEL, 7);
+		xsi_sel = AIROHA_SCU_PON_XSI_USXGMII;
+		rx_interface = PHY_INTERFACE_MODE_10GBASER;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* Switch WAN_SEL and XSI while XFI reset remains asserted. */
+	ret = reset_control_assert(priv->xfi_rst);
+	if (ret)
+		return ret;
+
+	regmap_update_bits(priv->scu, AIROHA_SCU_SSTR,
+			   AIROHA_SCU_PON_XSI_SEL, xsi_sel);
+	regmap_update_bits(priv->scu, AIROHA_SCU_WAN_CONF,
+			   AIROHA_SCU_WAN_SEL, wan_sel);
+
+	ret = reset_control_deassert(priv->xfi_rst);
+	if (ret)
+		return ret;
+
+	ret = reset_control_bulk_assert(ARRAY_SIZE(priv->rsts), priv->rsts);
+	if (ret)
+		return ret;
+
+	ret = reset_control_bulk_deassert(ARRAY_SIZE(priv->rsts), priv->rsts);
+	if (ret)
+		return ret;
+
+	port->interface = rx_interface;
+	priv->pon_mode = mode;
+	/* The optical frontend supplies both electrical settings before PMA bring-up. */
+	ret = regmap_write(priv->pcs_pma[port->index],
+			   AIROHA_PCS_PMA_XPON_SETTING_0, xpon_setting0);
+	if (ret)
+		return ret;
+	ret = regmap_write(priv->pcs_pma[port->index],
+			   AIROHA_PCS_PMA_XPON_SETTING_1, xpon_setting1);
+	if (ret)
+		return ret;
+
+	/* SoC match data selects the receiver initialization sequence. */
+	ret = priv->data->pon_start_rx(priv, port->index, rx_interface);
+	if (ret && ret != -EIO)
+		return ret;
+	/* Initial setup preserves register state; get_rx_status() reports FreqDet lock. */
+	if (ret == -EIO)
+		dev_dbg(priv->dev,
+			"PON initial calibration has no FreqDet lock; waiting for RX_RDY/retrain\n");
+
+	dev_info(priv->dev, "PON line configured: mode=%u, WAN_SEL=%lu, full SerDes analog init\n",
+		 mode,
+		 FIELD_GET(AIROHA_SCU_WAN_SEL, wan_sel));
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_pon_config_rx);
+
+int airoha_pcs_pon_retrain_rx(struct phylink_pcs *pcs)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	enum airoha_pcs_pon_mode mode;
+	int ret;
+
+	if (!pcs)
+		return -EINVAL;
+
+	port = to_airoha_pcs_port(pcs);
+	priv = port->priv;
+	if (priv->data->port_type != AIROHA_PCS_PON)
+		return -EOPNOTSUPP;
+
+	mode = priv->pon_mode;
+	if (mode > AIROHA_PCS_PON_MODE_EPON_10G_10G)
+		return -EINVAL;
+
+	ret = priv->data->pon_retrain_rx(priv, port->index, port->interface);
+	if (ret && ret != -EIO)
+		return ret;
+	if (ret == -EIO)
+		dev_dbg(priv->dev,
+			"PON retrain completed without FreqDet lock\n");
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_pon_retrain_rx);
+
+int airoha_pcs_pon_stop_rx(struct phylink_pcs *pcs)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+
+	if (!pcs)
+		return -EINVAL;
+
+	port = to_airoha_pcs_port(pcs);
+	priv = port->priv;
+	if (priv->data->port_type != AIROHA_PCS_PON)
+		return -EOPNOTSUPP;
+
+	return priv->data->pon_stop_rx(priv, port->index);
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_pon_stop_rx);
+
+int airoha_pcs_pon_get_rx_status(struct phylink_pcs *pcs,
+				 struct airoha_pcs_pon_rx_status *status)
+{
+	struct airoha_pcs_port *port;
+	struct airoha_pcs_priv *priv;
+	u32 freqdet, freqdet_target, ready_disable, ready_force, reset, sigdet;
+	int ret;
+
+	if (!pcs || !status)
+		return -EINVAL;
+
+	port = to_airoha_pcs_port(pcs);
+	priv = port->priv;
+	if (priv->data->port_type != AIROHA_PCS_PON)
+		return -EOPNOTSUPP;
+
+	/* Read PON state from sigdet while DIG_RESERVE_0 retains the RX rate. */
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_DIG_RO_RESERVE_2, &sigdet);
+	if (ret)
+		return ret;
+	status->signal_detected = !!(sigdet & AIROHA_PCS_RX_SIGDET);
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_DIG_RESERVE_0,
+			  &status->rx_mode_raw);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_RX_FREQDET, &freqdet);
+	if (ret)
+		return ret;
+
+	/* FreqDet reports lock of the PMA frequency feedback loop. */
+	status->freqdet_locked = freqdet & AIROHA_PCS_PMA_FBCK_LOCK;
+	status->frequency_level = FIELD_GET(AIROHA_PCS_PMA_FL_OUT, freqdet);
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_SS_RX_FREQ_DET_2, &freqdet_target);
+	if (ret)
+		return ret;
+	status->frequency_target =
+		(FIELD_GET(AIROHA_PCS_PMA_LOCK_TARGET_BEG, freqdet_target) +
+		 FIELD_GET(AIROHA_PCS_PMA_LOCK_TARGET_END, freqdet_target)) / 2;
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  &ready_force);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  &ready_disable);
+	if (ret)
+		return ret;
+	status->rx_ready_gate =
+		(ready_force & AIROHA_PCS_PMA_FORCE_RX_RDY) &&
+		!(ready_disable & AIROHA_PCS_PMA_DISB_RX_RDY);
+
+	ret = regmap_read(priv->pcs_pma[port->index],
+			  AIROHA_PCS_PMA_SW_RST_SET, &reset);
+	if (ret)
+		return ret;
+	status->rx_fifo_reset_released =
+		!!(reset & AIROHA_PCS_PMA_SW_RX_FIFO_RST_N);
+	status->calibration_stage = READ_ONCE(priv->pon_stage);
+	status->calibration_error = READ_ONCE(priv->pon_last_error);
+	status->calibration_runs = READ_ONCE(priv->pon_calibration_runs);
+	status->eo_fom = READ_ONCE(priv->pon_eo_fom);
+	status->eo_gain = READ_ONCE(priv->pon_eo_gain);
+	status->eo_peaking = READ_ONCE(priv->pon_eo_peaking);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(airoha_pcs_pon_get_rx_status);
