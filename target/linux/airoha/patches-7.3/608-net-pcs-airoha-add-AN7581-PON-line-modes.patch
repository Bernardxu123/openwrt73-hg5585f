+	AN7581_PON_PMA(0x38c, 1, 0, 1),
+	AN7581_PON_ANA(0x0fc, 25, 24, 0),
+	AN7581_PON_ANA(0x0fc, 20, 16, 8),
+	AN7581_PON_ANA(0x0fc, 10, 8, 5),
+	AN7581_PON_ANA(0x0fc, 2, 0, 5),
+	AN7581_PON_PMA(0x108, 8, 8, 0),
+	AN7581_PON_PMA(0x108, 16, 16, 0),
+	AN7581_PON_PMA(0x108, 24, 24, 0),
+	AN7581_PON_PMA(0x10c, 0, 0, 0),
+	AN7581_PON_PMA(0x108, 0, 0, 0),
+	AN7581_PON_PMA(0x10c, 16, 16, 0),
+	AN7581_PON_PMA(0x808, 8, 8, 1),
+	AN7581_PON_PMA(0x808, 0, 0, 0),
+	AN7581_PON_ANA(0x100, 1, 0, 0),
+	AN7581_PON_ANA(0x108, 25, 24, 0),
+	AN7581_PON_PMA(0x460, 1, 1, 1),
+	AN7581_PON_PMA(0x460, 5, 5, 1),
+	AN7581_PON_PMA(0x818, 16, 16, 0),
+	AN7581_PON_PMA(0x818, 16, 16, 1),
+};
