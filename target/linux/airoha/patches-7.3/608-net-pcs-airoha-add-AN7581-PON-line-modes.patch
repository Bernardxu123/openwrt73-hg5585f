+static void an7581_pcs_pon_eye_setting(struct airoha_pcs_priv *priv,
+					int index)
+{
+	struct regmap_field **ana = priv->pcs_ana_fields[index];
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* WAN_SEL 9 uses the XG-PON 9.95328G eye mask and horizontal range. */
+	regmap_field_write(ana[AN7581_PCS_CDR_LPF_RATIO], 0);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_0,
+			   AIROHA_PCS_PMA_EYE_MASK |
+			   AIROHA_PCS_PMA_CNTFOREVER |
+			   AIROHA_PCS_PMA_CNTLEN,
+			   FIELD_PREP(AIROHA_PCS_PMA_EYE_MASK, 0xff) |
+			   FIELD_PREP(AIROHA_PCS_PMA_CNTLEN, 0xf8));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEINDEX_CTRL_0,
+			   AIROHA_PCS_PMA_X_MIN | AIROHA_PCS_PMA_X_MAX,
+			   FIELD_PREP(AIROHA_PCS_PMA_X_MIN, 0x1c0) |
+			   FIELD_PREP(AIROHA_PCS_PMA_X_MAX, 0x240));
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_2,
+			  AIROHA_PCS_PMA_DATA_SHIFT);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEINDEX_CTRL_1,
+			   AIROHA_PCS_PMA_INDEX_MODE |
+			   AIROHA_PCS_PMA_Y_MAX | AIROHA_PCS_PMA_Y_MIN, 0);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEINDEX_CTRL_2,
+			   AIROHA_PCS_PMA_EYEDUR,
+			   FIELD_PREP(AIROHA_PCS_PMA_EYEDUR, 0xfff8));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEINDEX_CTRL_3,
+			   AIROHA_PCS_PMA_EYE_NEXTPTS |
+			   AIROHA_PCS_PMA_EYE_NEXTPTS_TOGGLE |
+			   AIROHA_PCS_PMA_EYE_NEXTPTS_SEL,
+			   AIROHA_PCS_PMA_EYE_NEXTPTS);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEOPENING_CTRL_0,
+			   AIROHA_PCS_PMA_EYECNT_VTH |
+			   AIROHA_PCS_PMA_EYECNT_HTH,
+			   FIELD_PREP(AIROHA_PCS_PMA_EYECNT_VTH, 4) |
+			   FIELD_PREP(AIROHA_PCS_PMA_EYECNT_HTH, 4));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEOPENING_CTRL_1,
+			   AIROHA_PCS_PMA_EO_VTH | AIROHA_PCS_PMA_EO_HTH,
+			   FIELD_PREP(AIROHA_PCS_PMA_EO_VTH, 4) |
+			   FIELD_PREP(AIROHA_PCS_PMA_EO_HTH, 4));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PHY_EQ_CTRL_1,
+			   AIROHA_PCS_PMA_B_ZERO_SEL |
+			   AIROHA_PCS_PMA_HEO_EMPHASIS |
+			   AIROHA_PCS_PMA_A_MGAIN |
+			   AIROHA_PCS_PMA_A_LGAIN, 0);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PHY_EQ_CTRL_2,
+			   AIROHA_PCS_PMA_A_SEL,
+			   FIELD_PREP(AIROHA_PCS_PMA_A_SEL, 1));
+}
+
+static void an7581_pcs_pon_eye_cal(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_TX_RATE_CTRL,
+			  AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_PR_PIEYE |
+			  AIROHA_PCS_PMA_FORCE_DA_CDR_PR_PIEYE);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_CDR_PR_FLL_COR,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_DAC_EYE |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_DAC_EYE,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_DAC_EYE);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PHY_EQ_CTRL_0,
+			   AIROHA_PCS_PMA_EQ_EN_DELAY,
+			   FIELD_PREP(AIROHA_PCS_PMA_EQ_EN_DELAY, 0x80));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_PI_CAL,
+			   AIROHA_PCS_PMA_KPGAIN,
+			   FIELD_PREP(AIROHA_PCS_PMA_KPGAIN, 1));
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			  AIROHA_PCS_PMA_EQ_PI_CAL_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			  AIROHA_PCS_PMA_FORCE_RX_AND_PICAL_RSTB |
+			  AIROHA_PCS_PMA_FORCE_REF_AND_PICAL_RSTB);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_6,
+			  AIROHA_PCS_PMA_DISB_RX_AND_PICAL_RSTB |
+			  AIROHA_PCS_PMA_DISB_REF_AND_PICAL_RSTB);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_0,
+			  AIROHA_PCS_PMA_DISB_RX_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_PICAL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			AIROHA_PCS_PMA_EQ_PI_CAL_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			AIROHA_PCS_PMA_FORCE_RX_AND_PICAL_RSTB |
+			AIROHA_PCS_PMA_FORCE_REF_AND_PICAL_RSTB);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			AIROHA_PCS_PMA_FORCE_RX_OR_PICAL_EN);
+	udelay(1000);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			  AIROHA_PCS_PMA_FORCE_RX_OR_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_3,
+			  AIROHA_PCS_PMA_DISB_RQ_PI_CAL_RDY);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_3,
+			AIROHA_PCS_PMA_FORCE_EQ_PI_CAL_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_5,
+			  AIROHA_PCS_PMA_DISB_EYECNT_RDY);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			AIROHA_PCS_PMA_FORCE_EYECNT_RDY);
+}
+
+static u32 an7581_pcs_pon_readout_eo(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 eye, ready;
+	u32 left, right;
+
+	/* Latch four FLL read-only values before toggling the RO latch. */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FLL_6,
+			AIROHA_PCS_PMA_LNX_SW_FLL_4_LATCH_EN |
+			AIROHA_PCS_PMA_LNX_SW_FLL_3_LATCH_EN |
+			AIROHA_PCS_PMA_LNX_SW_FLL_2_LATCH_EN |
+			AIROHA_PCS_PMA_LNX_SW_FLL_1_LATCH_EN);
+	udelay(50);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FLL_6,
+			  AIROHA_PCS_PMA_LNX_SW_FLL_4_LATCH_EN |
+			  AIROHA_PCS_PMA_LNX_SW_FLL_3_LATCH_EN |
+			  AIROHA_PCS_PMA_LNX_SW_FLL_2_LATCH_EN |
+			  AIROHA_PCS_PMA_LNX_SW_FLL_1_LATCH_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DEBUG_0,
+			  AIROHA_PCS_PMA_RO_TOGGLE);
+	udelay(100);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DEBUG_0,
+			AIROHA_PCS_PMA_RO_TOGGLE);
+
+	regmap_read(pma, AIROHA_PCS_PMA_RX_TORGS_DEBUG_10, &eye);
+	left = FIELD_GET(AIROHA_PCS_PMA_EYE_EL, eye);
+	right = FIELD_GET(AIROHA_PCS_PMA_EYE_ER, eye);
+	regmap_read(pma, AIROHA_PCS_PMA_RX_TORGS_DEBUG_5, &ready);
+	if (!(ready & AIROHA_PCS_PMA_HEO_RDY)) {
+		/* Pulse the analog CDR LPF reset when HEO rejects a peaking point. */
+		regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_0,
+				  AIROHA_PCS_PMA_DISB_DA_XPON_CDR_LPF_RSTB);
+		regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_0,
+				  AIROHA_PCS_PMA_FORCE_DA_XPON_CDR_LPF_RSTB);
+		udelay(500);
+		regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_0,
+				AIROHA_PCS_PMA_FORCE_DA_XPON_CDR_LPF_RSTB);
+		udelay(500);
+	}
+
+	return abs((int)right - (int)left);
+}
+
+static u32 an7581_pcs_pon_eye_eo(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 fom;
+
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_0,
+			   AIROHA_PCS_PMA_CNTLEN,
+			   FIELD_PREP(AIROHA_PCS_PMA_CNTLEN, 10));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYEINDEX_CTRL_2,
+			   AIROHA_PCS_PMA_EYEDUR,
+			   FIELD_PREP(AIROHA_PCS_PMA_EYEDUR, 0x44c));
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_8,
+			  AIROHA_PCS_PMA_DISB_EYE_RESET_PLU_O |
+			  AIROHA_PCS_PMA_DISB_EYE_TOP_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			AIROHA_PCS_PMA_FORCE_EYE_RESET_PLU_O);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			  AIROHA_PCS_PMA_FORCE_EYE_RESET_PLU_O |
+			  AIROHA_PCS_PMA_FORCE_EYE_TOP_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			AIROHA_PCS_PMA_FORCE_EYE_TOP_EN);
+	udelay(5500);
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_2,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_EYE |
+			AIROHA_PCS_PMA_DISB_DA_XPON_CDR_PR_PIEYE);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_1,
+			AIROHA_PCS_PMA_DISB_EYEDUR_INIT_B |
+			AIROHA_PCS_PMA_DISB_EYEDUR_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_7,
+			AIROHA_PCS_PMA_DISB_EYECNT_RX_RST_B);
+	fom = an7581_pcs_pon_readout_eo(priv, index);
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			AIROHA_PCS_PMA_FORCE_EYE_RESET_PLU_O);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			  AIROHA_PCS_PMA_FORCE_EYE_TOP_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_3,
+			  AIROHA_PCS_PMA_DISB_RQ_PI_CAL_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_3,
+			  AIROHA_PCS_PMA_FORCE_EQ_PI_CAL_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_5,
+			  AIROHA_PCS_PMA_DISB_EYECNT_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			  AIROHA_PCS_PMA_FORCE_EYECNT_RDY);
+
+	return fom;
+}
+
+static void an7581_pcs_pon_eo_scan(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 best_fom = 0;
+	u8 best_peaking = 0;
+	u8 peaking;
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_CDR_PR_PIEYE_PWDB,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_PR_PIEYE_PWDB |
+			AIROHA_PCS_PMA_FORCE_DA_CDR_PR_PIEYE_PWDB);
+	an7581_pcs_pon_eye_setting(priv, index);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PHY_EQ_CTRL_0,
+			   AIROHA_PCS_PMA_EQ_EN_DELAY,
+			   FIELD_PREP(AIROHA_PCS_PMA_EQ_EN_DELAY, 0x80));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_PI_CAL,
+			   AIROHA_PCS_PMA_KPGAIN,
+			   FIELD_PREP(AIROHA_PCS_PMA_KPGAIN, 4));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_FE_GAIN_CTRL,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_GAIN_CTRL |
+			   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_GAIN_CTRL, 1));
+
+	/* Sweep peaking values 0..7 with gain fixed at 1. */
+	for (peaking = 0; peaking < 8; peaking++) {
+		u32 fom;
+
+		regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_JCPLL_SDM_SCAN,
+				   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_PEAKING_CTRL |
+				   AIROHA_PCS_PMA_FORCE_DA_RX_FE_PEAKING_CTRL,
+				   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_PEAKING_CTRL |
+				   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_PEAKING_CTRL,
+					      peaking));
+		an7581_pcs_pon_eye_cal(priv, index);
+		fom = an7581_pcs_pon_eye_eo(priv, index);
+		if (fom > best_fom) {
+			best_fom = fom;
+			best_peaking = peaking;
+		}
+	}
+
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_JCPLL_SDM_SCAN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_PEAKING_CTRL |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_FE_PEAKING_CTRL,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_FE_PEAKING_CTRL |
+			   FIELD_PREP(AIROHA_PCS_PMA_FORCE_DA_RX_FE_PEAKING_CTRL,
+				      best_peaking));
+	priv->pon_eo_gain = 1;
+	priv->pon_eo_peaking = best_peaking;
+	priv->pon_eo_fom = best_fom;
+}
+
+static void an7581_pcs_pon_tdc_on(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_update_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_6,
+			   AIROHA_PCS_PMA_LCPLL_NCPO_CHG_DELAY,
+			   AIROHA_PCS_PMA_LCPLL_NCPO_CHG_DELAY_SEL);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_0,
+			   AIROHA_PCS_PMA_LCPLL_PON_RX_CDR_DIVTDC,
+			   AIROHA_PCS_PMA_LCPLL_PON_RX_CDR_DIVTDC_16);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_TXPLL_SDM_PCW_CHG,
+			  AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_SDM_PCW_CHG);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_CDR_PR_IDAC,
+			  AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_SDM_PCW);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_PW_5,
+			AIROHA_PCS_PMA_LCPLL_AUTOK_TDC);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_3,
+			  AIROHA_PCS_PMA_LCPLL_NCPO_LOAD);
+	udelay(100);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_5,
+			  AIROHA_PCS_PMA_LCPLL_TDC_AUTOPW_NCPO);
+	udelay(100);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_1,
+			AIROHA_PCS_PMA_LCPLL_GPON_SEL);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_PW_0,
+			AIROHA_PCS_PMA_LCPLL_TDC_DIG_PWDB);
+	udelay(5000);
+}
+
+static void an7581_pcs_pon_rx_ready(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			AIROHA_PCS_PMA_FORCE_RX_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_RDY);
+	udelay(10);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_SW_RST_SET,
+			  AIROHA_PCS_PMA_SW_RX_FIFO_RST_N);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_SW_RST_SET,
+			AIROHA_PCS_PMA_SW_RX_FIFO_RST_N);
+	udelay(100);
+}
+
+static void an7581_pcs_pon_txpll_on(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	struct regmap *ana = priv->pcs_ana;
+
+	/*
+	 * PLUG_IN reloads TXPLL K-band after digital reset and TDC recovery.
+	 * These writes switch the shared upstream clock within the retrain path.
+	 * ANA 0x074 retains the latched value after link training.
+	 */
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_TXPLL_CKOUT_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_EN |
+			   AIROHA_PCS_PMA_FORCE_DA_TXPLL_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_EN |
+			   AIROHA_PCS_PMA_FORCE_DA_TXPLL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_SS_LCPLL_PWCTL_SETTING_0,
+			AIROHA_PCS_PMA_SW_LCPLL_EN);
+	udelay(6);
+
+	/*
+	 * ANA 0x04c is TXPLL K-band load in the single-lane PON register map.
+	 * The common header uses the Ethernet name JCPLL_FREQ_MEAS_EN
+	 * for bit 0 of the same register.
+	 */
+	regmap_set_bits(ana, AIROHA_PCS_ANA_PXP_JCPLL_FREQ_MEAS_EN, BIT(0));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_TXPLL_CKOUT_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_CKOUT_EN |
+			   AIROHA_PCS_PMA_FORCE_DA_TXPLL_CKOUT_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_TXPLL_CKOUT_EN |
+			   AIROHA_PCS_PMA_FORCE_DA_TXPLL_CKOUT_EN);
+	regmap_set_bits(ana, AIROHA_PCS_ANA_PXP_TXPLL_TCL_KBAND_VREF,
+			AIROHA_PCS_ANA_TXPLL_FREQ_MEAS_EN);
+	regmap_clear_bits(ana, AIROHA_PCS_ANA_PXP_TXPLL_TCL_KBAND_VREF,
+			  AIROHA_PCS_ANA_TXPLL_VREF_SEL);
+	regmap_update_bits(ana, AIROHA_PCS_ANA_PXP_TXPLL_PHY_CK1_EN,
+			   AIROHA_PCS_ANA_TXPLL_PHY_CK2_EN |
+			   AIROHA_PCS_ANA_TXPLL_PHY_CK1_EN,
+			   AIROHA_PCS_ANA_TXPLL_PHY_CK2_EN |
+			   AIROHA_PCS_ANA_TXPLL_PHY_CK1_EN);
+
+	/* Release the load and frequency-measure pulses while retaining PLL output. */
+	regmap_clear_bits(ana, AIROHA_PCS_ANA_PXP_JCPLL_FREQ_MEAS_EN,
+			  BIT(0) | BIT(24) | BIT(16));
+	udelay(500);
+}
+
+static void an7581_pcs_pon_normal_data(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/*
+	 * The BIST template ends on normal PMA data. After clearing TX_BIST_GEN/R2T,
+	 * MAC/BEN controls upstream bursts.
+	 */
+	regmap_write(pma, AIROHA_PCS_PMA_BISTCTL_ALIGN_PAT, 0x8ff1fd53);
+	regmap_write(pma, AIROHA_PCS_PMA_BISTCTL_PRBS_INITIAL_SEED, 0x0ff1fd53);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_BISTCTL_PRBS_FAIL_THRESHOLD,
+			   AIROHA_PCS_PMA_BISTCTL_PRBS_FAIL_THRESHOLD_MASK, 1);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_BISTCTL_CONTROL,
+			   AIROHA_PCS_PMA_BISTCTL_PAT_SEL,
+			   AIROHA_PCS_PMA_BISTCTL_PAT_SEL_PRBS31);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_BISTCTL_POLLUTION,
+			AIROHA_PCS_PMA_BIST_TX_DATA_POLLUTION_LATCH);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_SS_BIST_1,
+			  AIROHA_PCS_PMA_ANLT_PX_LNX_LT_LOS |
+			  AIROHA_PCS_PMA_LNX_BISTCTL_BIT_ERROR_RST_SEL);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_ADD_XPON_MODE_1,
+			  AIROHA_PCS_PMA_TX_BIST_GEN_EN |
+			  AIROHA_PCS_PMA_R2T_MODE);
+}
+
+int an7581_pcs_pon_first_plug(struct airoha_pcs_priv *priv, int index,
+			      phy_interface_t interface)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 freqdet;
+	int prcal_ret;
+	int ret;
+
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    interface != PHY_INTERFACE_MODE_10GBASER)
+		return -EOPNOTSUPP;
+
+	priv->pon_last_error = 0;
+	priv->pon_calibration_runs++;
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_STATIC);
+	ret = an7581_pcs_pon_xgpon_static(priv, index);
+	if (ret)
+		goto fail;
+	an7581_pcs_pon_apply_impedance_defaults(priv, index);
+
+	/* FIRST_PLUG_IN starts with preset, TDC off, RX_on, PrCal, and L2R. */
+	ret = an7581_pcs_pon_apply_fields(priv, index,
+					  an7581_xgpon_rx_preset,
+					  ARRAY_SIZE(an7581_xgpon_rx_preset));
+	if (ret)
+		goto fail;
+	an7581_pcs_pon_tdc_off(priv, index);
+	ret = an7581_pcs_pon_apply_fields(priv, index, an7581_xgpon_rx_on,
+					  ARRAY_SIZE(an7581_xgpon_rx_on));
+	if (ret)
+		goto fail;
+	/* XPON_RX_on(Async_XEPON) selects gain 3 and RX_REV 0x18b0. */
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G) {
+		regmap_update_bits(priv->pcs_pma[index], 0x88c, GENMASK(1, 0), 3);
+		regmap_update_bits(priv->pcs_ana, 0x0d4, GENMASK(15, 0), 0x18b0);
+	}
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_PRCAL);
+	prcal_ret = an7581_pcs_pon_xgpon_prcal(priv, index);
+	if (prcal_ret)
+		priv->pon_last_error = prcal_ret;
+	an7581_pcs_pon_l2r(priv, index);
+
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_OSCAL);
+	an7581_pcs_pon_oscal(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_PICAL);
+	an7581_pcs_pon_pical(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_PDOS);
+	an7581_pcs_pon_pdos(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_FEOS);
+	an7581_pcs_pon_feos(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_SDCAL);
+	an7581_pcs_pon_sdcal(priv, index);
+	an7581_pcs_pon_phy_status(priv, index);
+	an7581_pcs_pon_full_reset(priv, index);
+	an7581_pcs_pon_l2d(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_EO_SCAN);
+	an7581_pcs_pon_eo_scan(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_TDC);
+	an7581_pcs_pon_tdc_on(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_RX_READY);
+	an7581_pcs_pon_rx_ready(priv, index);
+	an7581_pcs_pon_normal_data(priv, index);
+
+	regmap_read(pma, AIROHA_PCS_PMA_RX_FREQDET, &freqdet);
+	dev_info(priv->dev,
+		 "PON PMA sequence finished: mode=%u lock=%d fl=0x%04x prcal=%d eo(gain=%u peak=%u fom=%u)\n",
+		 priv->pon_mode,
+		 !!(freqdet & AIROHA_PCS_PMA_FBCK_LOCK),
+		 (unsigned int)FIELD_GET(AIROHA_PCS_PMA_FL_OUT, freqdet),
+		 prcal_ret, priv->pon_eo_gain, priv->pon_eo_peaking,
+		 priv->pon_eo_fom);
+
+	return 0;
+
+fail:
+	priv->pon_last_error = ret;
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_FAILED);
+	return ret;
+}
+
+int an7581_pcs_pon_plug_in(struct airoha_pcs_priv *priv, int index,
+			   phy_interface_t interface)
+{
+	if (priv->data->port_type != AIROHA_PCS_PON ||
+	    interface != PHY_INTERFACE_MODE_10GBASER)
+		return -EOPNOTSUPP;
+
+	/* PLUG_IN reuses the PrCal and EO values from FIRST_PLUG_IN. */
+	an7581_pcs_pon_full_reset(priv, index);
+	an7581_pcs_pon_l2d(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_TDC);
+	an7581_pcs_pon_tdc_on(priv, index);
+	an7581_pcs_pon_txpll_on(priv, index);
+	an7581_pcs_pon_rx_ready(priv, index);
+	an7581_pcs_pon_phy_status(priv, index);
+	an7581_pcs_pon_normal_data(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_RX_READY);
+
+	return 0;
+}
+
+int an7581_pcs_pon_plug_out(struct airoha_pcs_priv *priv, int index)
+{
+	if (priv->data->port_type != AIROHA_PCS_PON)
+		return -EOPNOTSUPP;
+
+	/* PLUG_OUT runs TDC off and L2R while retaining first-plug calibration. */
+	an7581_pcs_pon_tdc_off(priv, index);
+	an7581_pcs_pon_l2r(priv, index);
+	an7581_pcs_pon_set_stage(priv, AN7581_PON_STAGE_PLUG_OUT);
+
+	return 0;
+}
+
+int an7581_pcs_pon_start_rx(struct airoha_pcs_priv *priv, int index,
+			    phy_interface_t interface)
+{
+	/* 1G and 2.5G PON modes use the existing bring-up path. */
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_GPON ||
+	    priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_1G)
+		return an7581_pcs_bringup(priv, index, interface);
+
+	return an7581_pcs_pon_first_plug(priv, index, interface);
+}
+
+int an7581_pcs_pon_retrain_rx(struct airoha_pcs_priv *priv, int index,
+			      phy_interface_t interface)
+{
+	/* 10G modes retain first calibration and use the PLUG_IN retrain path. */
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_GPON ||
+	    priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_1G)
+		return an7581_pcs_bringup(priv, index, interface);
+
+	return an7581_pcs_pon_plug_in(priv, index, interface);
+}
+
+int an7581_pcs_pon_stop_rx(struct airoha_pcs_priv *priv, int index)
+{
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_1G)
+		return 0;
+
+	return an7581_pcs_pon_plug_out(priv, index);
+}
+
 static int an7581_pcs_phya_bringup(struct airoha_pcs_priv *priv,
 				   int index, phy_interface_t interface)
