+/* FIRST_PLUG_IN PON PMA calibration and RX-ready sequence. */
+static void an7581_pcs_pll_bringup(struct airoha_pcs_priv *priv,
+				    int index, phy_interface_t interface);
+
+/* XG-PON 9.95328G PLL/PMA register template. */
+/* Entries use read-modify-write to preserve adjacent register fields. */
+struct an7581_pon_reg_field {
+	bool ana;
+	u16 reg;
+	u8 msb;
+	u8 lsb;
+	u32 val;
+};
+
+#define AN7581_PON_ANA(_reg, _msb, _lsb, _val) \
+	{ true, (_reg), (_msb), (_lsb), (_val) }
+#define AN7581_PON_PMA(_reg, _msb, _lsb, _val) \
+	{ false, (_reg), (_msb), (_lsb), (_val) }
+
+static int
+an7581_pcs_pon_apply_fields(struct airoha_pcs_priv *priv, int index,
+			    const struct an7581_pon_reg_field *fields,
+			    size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		const struct an7581_pon_reg_field *field = &fields[i];
+		struct regmap *map = field->ana ? priv->pcs_ana :
+						     priv->pcs_pma[index];
+		u32 mask = GENMASK(field->msb, field->lsb);
+		int ret;
+
+		ret = regmap_update_bits(map, field->reg, mask,
+					 (field->val << field->lsb) & mask);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
