+static void an7581_pcs_pon_set_stage(struct airoha_pcs_priv *priv,
+				      enum an7581_pon_stage stage)
+{
+	WRITE_ONCE(priv->pon_stage, stage);
+}
+
+#define AN7581_PON_RX_IMPEDANCE_DEFAULT	0x2
+#define AN7581_PON_TX_IMPEDANCE_DEFAULT	0x1
+
+static void an7581_pcs_pon_apply_impedance_defaults(
+	struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* EN7581_EFUSE=0 defaults from xpon_pma_param_opt(). */
+	regmap_update_bits(priv->pcs_ana, AIROHA_PCS_ANA_PXP_RX_SIGDET_NOVTH,
+			   AIROHA_PCS_ANA_RX_FE_50OHMS_SEL,
+			   FIELD_PREP(AIROHA_PCS_ANA_RX_FE_50OHMS_SEL,
+				      AN7581_PON_RX_IMPEDANCE_DEFAULT));
+
+	regmap_update_bits(pma, AIROHA_PCS_PMA_TX_CALIB_0,
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMP_SEL |
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMP_SEL_EN,
+			   FIELD_PREP(AIROHA_PCS_PMA_TXCALIB_FORCE_TERMP_SEL,
+				      AN7581_PON_TX_IMPEDANCE_DEFAULT) |
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMP_SEL_EN);
+
+	regmap_update_bits(pma, AIROHA_PCS_PMA_TX_CALIB_1,
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMN_SEL |
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMN_SEL_EN,
+			   FIELD_PREP(AIROHA_PCS_PMA_TXCALIB_FORCE_TERMN_SEL,
+				      AN7581_PON_TX_IMPEDANCE_DEFAULT) |
+			   AIROHA_PCS_PMA_TXCALIB_FORCE_TERMN_SEL_EN);
+}
+
+static int an7581_pcs_pon_xgpon_static(struct airoha_pcs_priv *priv,
+				       int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	struct regmap *ana = priv->pcs_ana;
+	int ret;
+
+#define APPLY_XGPON_TABLE(_table) do { \
+	ret = an7581_pcs_pon_apply_fields(priv, index, (_table), \
+					  ARRAY_SIZE(_table)); \
+	if (ret) \
+		return ret; \
+} while (0)
+
+	/* Apply the table in pon_CfgPhyType(9) register order. */
+	APPLY_XGPON_TABLE(an7581_xgpon_cfg_pre);
+	APPLY_XGPON_TABLE(an7581_xgpon_txpll);
+	APPLY_XGPON_TABLE(an7581_xgpon_tx);
+	APPLY_XGPON_TABLE(an7581_xgpon_cfg_mid);
+	APPLY_XGPON_TABLE(an7581_xgpon_rx);
+	APPLY_XGPON_TABLE(an7581_xgpon_ana);
+	APPLY_XGPON_TABLE(an7581_xgpon_cfg_post);
+
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_XGSPON) {
+		/* XPON_TX(Sync_XGSPON) uses a 16-bit bus and 9.95328G upstream clock. */
+		regmap_update_bits(pma, 0x77c, GENMASK(19, 16), 5 << 16);
+		regmap_update_bits(pma, 0x784, GENMASK(1, 0), 2);
+		regmap_update_bits(pma, 0x580, GENMASK(1, 0), 2);
+		regmap_update_bits(pma, 0x468,
+				   GENMASK(14, 8) | GENMASK(6, 0),
+				   (0x0d << 8) | 0x30);
+
+		/* TXPLL K-band divisor used by XPON_ANA(9). */
+		regmap_update_bits(ana, 0x058, GENMASK(10, 8), 5 << 8);
+	} else if (priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G ||
+	    priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_10G) {
+		/* XPON_TXPLL(10) uses 10.3125G PCW and EPON TDC shadow values. */
+		regmap_update_bits(pma, 0x798, GENMASK(30, 0), 0x08400000);
+		regmap_update_bits(pma, 0x048, GENMASK(30, 0), 0x10800000);
+		regmap_update_bits(pma, 0x04c, GENMASK(30, 0), 0x10800000);
+		if (priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G) {
+			regmap_update_bits(pma, 0x77c, GENMASK(19, 16), 1 << 16);
+			regmap_update_bits(pma, 0x784, GENMASK(1, 0), 1);
+			regmap_update_bits(pma, 0x580, GENMASK(1, 0), 1);
+			regmap_update_bits(pma, 0x468,
+					   GENMASK(14, 8) | GENMASK(6, 0),
+					   (2 << 8) | 6);
+		} else {
+			regmap_update_bits(pma, 0x77c, GENMASK(19, 16), 5 << 16);
+			regmap_update_bits(pma, 0x784, GENMASK(1, 0), 2);
+			regmap_update_bits(pma, 0x580, GENMASK(1, 0), 2);
+			regmap_update_bits(pma, 0x468,
+					   GENMASK(14, 8) | GENMASK(6, 0),
+					   (0x0d << 8) | 0x30);
+
+			/*
+			 * Sync_XEPON uses XPON_ANA(10); Async_XEPON retains
+			 * TXPLL_VCO_CFIX=3 from the common XPON_ANA(1) sequence.
+			 */
+			regmap_update_bits(ana, 0x074, GENMASK(25, 24), 1 << 24);
+			regmap_update_bits(pma, 0x778, GENMASK(5, 0), 0x0e);
+			regmap_update_bits(pma, 0x780, GENMASK(4, 0), 0x04);
+		}
+	}
+
+#undef APPLY_XGPON_TABLE
+
+	/* JCPLL_on(): enable PLL and output, then wait for the analogue clock. */
+	regmap_update_bits(pma, 0x828, BIT(24) | BIT(16) | BIT(8) | BIT(0),
+			   BIT(24) | BIT(16) | BIT(8) | BIT(0));
+	udelay(500);
+
+	/* TXPLL_on() configures SW_LCPLL_EN and the K-band TDC reference. */
+	regmap_update_bits(pma, 0x854, BIT(24) | BIT(16),
+			   BIT(24) | BIT(16));
+	regmap_set_bits(pma, 0x000, BIT(24));
+	udelay(6);
+	regmap_set_bits(ana, 0x04c, BIT(0));
+	regmap_update_bits(pma, 0x854, BIT(8) | BIT(0), BIT(8) | BIT(0));
+	regmap_set_bits(ana, 0x094, BIT(16));
+	regmap_clear_bits(ana, 0x094, BIT(8));
+	regmap_update_bits(ana, 0x060, BIT(8) | BIT(0), BIT(8) | BIT(0));
+	regmap_clear_bits(ana, 0x04c, BIT(0) | BIT(24) | BIT(16));
+	udelay(500);
+
+	/* Line encoding rate selects the XPON_DIG_fm_on() window. */
+	regmap_write(pma, 0x14c, 0x7fff7fff);
+	if (priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G ||
+	    priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_10G) {
+		regmap_write(pma, 0x150, (0x9f43 << 16) | 0x9e7a);
+		regmap_write(pma, 0x154, (0x9f43 << 16) | 0x9e7a);
+	} else {
+		regmap_write(pma, 0x150, (0xa4ff << 16) | 0xa436);
+		regmap_write(pma, 0x154, (0xa4ff << 16) | 0xa436);
+	}
+
+	/* XPON_TX_on() releases the TX state machine; the frontend controls bursts. */
+	regmap_set_bits(pma, 0x260, BIT(0));
+	regmap_update_bits(pma, 0x410, BIT(8) | BIT(0), BIT(8) | BIT(0));
+	regmap_set_bits(pma, 0x260, BIT(8) | BIT(0));
+	regmap_set_bits(pma, 0x414, BIT(16));
+	udelay(100);
+
+	return 0;
+}
+
+static int an7581_pcs_pon_xgpon_prcal_once(struct airoha_pcs_priv *priv,
+					   int index, u16 *selected_idac,
+					   u16 *final_fl)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	struct regmap *ana = priv->pcs_ana;
+	const u16 target =
+		priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G ||
+		priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_10G ?
+		0x9edf : 0xa49a;
+	u32 val;
+	u16 idac = 0;
+	int bit;
+	u8 major;
+
+	/* XPON_PrCal_WK(9) searches the major range, then converges over bits 7..0. */
+	regmap_set_bits(ana, 0x0f4, BIT(24));
+	regmap_update_bits(pma, 0x820,
+			   BIT(24) | BIT(16) | BIT(8) | BIT(0),
+			   BIT(24) | BIT(16) | BIT(8) | BIT(0));
+	regmap_set_bits(pma, 0x794, BIT(16));
+	regmap_set_bits(pma, 0x824, BIT(24));
+	regmap_clear_bits(pma, 0x824, BIT(16));
+	regmap_set_bits(pma, 0x824, BIT(16));
+
+	for (major = 1; major <= 7; major++) {
+		regmap_update_bits(pma, 0x794, GENMASK(10, 0), major << 8);
+		regmap_update_bits(pma, 0x158, GENMASK(2, 0), 3);
+		usleep_range(5000, 6000);
+		regmap_read(pma, 0x530, &val);
+		if (FIELD_GET(GENMASK(31, 16), val) > target)
+			idac = major << 8;
+	}
+
+	for (bit = 7; bit >= 0; bit--) {
+		u16 candidate = idac | BIT(bit);
+
+		regmap_update_bits(pma, 0x794, GENMASK(10, 0), candidate);
+		regmap_update_bits(pma, 0x158, GENMASK(2, 0), 3);
+		usleep_range(5000, 6000);
+		regmap_read(pma, 0x530, &val);
+		if (FIELD_GET(GENMASK(31, 16), val) >= target)
+			idac = candidate;
+		else
+			idac &= ~BIT(bit);
+	}
+
+	regmap_update_bits(pma, 0x794, GENMASK(10, 0), idac);
+	regmap_update_bits(pma, 0x158, GENMASK(2, 0), 3);
+	regmap_read(pma, 0x530, &val);
+	*selected_idac = idac;
+	*final_fl = FIELD_GET(GENMASK(31, 16), val);
+
+	/* Load the selected value through the FLL path and release calibration force. */
+	regmap_clear_bits(ana, 0x0f4, BIT(24));
+	regmap_update_bits(pma, 0x820,
+			   BIT(24) | BIT(16) | BIT(8) | BIT(0),
+			   BIT(24) | BIT(16));
+	regmap_clear_bits(pma, 0x794, BIT(16));
+	regmap_set_bits(pma, 0x19c, BIT(0));
+	regmap_update_bits(pma, 0x174, GENMASK(10, 0), idac);
+	regmap_clear_bits(pma, 0x824, BIT(16));
+	regmap_set_bits(pma, 0x824, BIT(16) | BIT(24));
+
+	return val & BIT(0) ? 0 : -EAGAIN;
+}
+
+static int an7581_pcs_pon_xgpon_prcal(struct airoha_pcs_priv *priv, int index)
+{
+	u16 idac = 0, fl = 0;
+	int attempt;
+	int ret = -EAGAIN;
+
+	/* XPON_RX_on() retries once when the first lock attempt misses. */
+	for (attempt = 1; attempt <= 2; attempt++) {
+		ret = an7581_pcs_pon_xgpon_prcal_once(priv, index, &idac, &fl);
+		if (!ret)
+			break;
+	}
+	if (attempt > 2)
+		attempt = 2;
+
+	dev_info(priv->dev,
+		 "PON PrCal: mode=%u attempt=%d idac=0x%03x lock=%d fl=0x%04x target=0x%04x\n",
+		 priv->pon_mode, attempt, idac, !ret, fl,
+		 priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_1G ||
+		 priv->pon_mode == AIROHA_PCS_PON_MODE_EPON_10G_10G ?
+		 0x9edf : 0xa49a);
+
+	return ret;
+}
+
+static void an7581_pcs_pon_tdc_off(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/*
+	 * XPON_TDC_off() latches NCPO before clearing GPON/XG-PON TDC selection
+	 * and powering down the digital TDC while leaving the analog CDR active.
+	 */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_3,
+			AIROHA_PCS_PMA_LCPLL_NCPO_LOAD);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_FLT_1,
+			  AIROHA_PCS_PMA_LCPLL_GPON_SEL);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_LCPLL_TDC_PW_0,
+			  AIROHA_PCS_PMA_LCPLL_TDC_DIG_PWDB);
+	udelay(1000);
+}
+
+static void an7581_pcs_pon_l2r(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* L2R releases lock-to-data and the forced LPF reset. */
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_CDR_LPF_LCK_2DATA,
+			  AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_RSTB |
+			  AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_RSTB |
+			  AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA |
+			  AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_LCK2DATA);
+	udelay(100);
+}
+
+static void an7581_pcs_pon_l2d(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* XPON_RX_L2D() waits 200 us after selecting lock-to-data. */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_CDR_LPF_LCK_2DATA,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_CDR_LPF_LCK2DATA |
+			AIROHA_PCS_PMA_FORCE_DA_CDR_LPF_LCK2DATA);
+	udelay(200);
+}
+
+static void an7581_pcs_pon_oscal(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* Offset calibration forces FBCK lock and enables the OSCAL clock and reset. */
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_8,
+			  AIROHA_PCS_PMA_DISB_FBCK_LOCK);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_9,
+			AIROHA_PCS_PMA_FORCE_FBCK_LOCK);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_JCPLL_SDM_SCAN_RSTB,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_CKON |
+			AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_CKON);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_RX_OSCAL_EN,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_RSTB |
+			AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_RSTB |
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_EN |
+			AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_EN);
+	udelay(200);
+
+	/* Return control to the sequencer after an RX_OS_EN edge starts calibration. */
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_0,
+			  AIROHA_PCS_PMA_DISB_RX_OS_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_OS_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_RX_OS_RDY);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+}
+
+static void an7581_pcs_pon_pical(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_2,
+			AIROHA_PCS_PMA_DISB_DA_XPON_CDR_PR_PIEYE);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_PI_CAL,
+			   AIROHA_PCS_PMA_KPGAIN,
+			   FIELD_PREP(AIROHA_PCS_PMA_KPGAIN, 4));
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PHY_EQ_CTRL_0,
+			   AIROHA_PCS_PMA_EQ_EN_DELAY,
+			   FIELD_PREP(AIROHA_PCS_PMA_EQ_EN_DELAY, 8));
+
+	/* Hold EQ, RX, and REF PI resets together, then release them in sequence. */
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			  AIROHA_PCS_PMA_EQ_PI_CAL_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			  AIROHA_PCS_PMA_FORCE_RX_AND_PICAL_RSTB |
+			  AIROHA_PCS_PMA_FORCE_REF_AND_PICAL_RSTB);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_6,
+			  AIROHA_PCS_PMA_DISB_RX_AND_PICAL_RSTB |
+			  AIROHA_PCS_PMA_DISB_REF_AND_PICAL_RSTB);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_3,
+			  AIROHA_PCS_PMA_DISB_RQ_PI_CAL_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			  AIROHA_PCS_PMA_FORCE_RX_OR_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_5,
+			  AIROHA_PCS_PMA_DISB_RX_OR_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_0,
+			  AIROHA_PCS_PMA_DISB_RX_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_3,
+			  AIROHA_PCS_PMA_FORCE_EQ_PI_CAL_RDY);
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			AIROHA_PCS_PMA_EQ_PI_CAL_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			AIROHA_PCS_PMA_FORCE_RX_AND_PICAL_RSTB |
+			AIROHA_PCS_PMA_FORCE_REF_AND_PICAL_RSTB);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			AIROHA_PCS_PMA_FORCE_RX_OR_PICAL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			AIROHA_PCS_PMA_FORCE_RX_PICAL_EN);
+	udelay(200);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_PICAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_6,
+			  AIROHA_PCS_PMA_FORCE_RX_OR_PICAL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_3,
+			AIROHA_PCS_PMA_FORCE_EQ_PI_CAL_RDY);
+}
+
+static void an7581_pcs_pon_pdos(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* Hold DAC and eye resets during PDOS calibration to stabilize sampling. */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_RX_FE_PWDB,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_PDOSCAL_EN |
+			AIROHA_PCS_PMA_FORCE_DA_RX_PDOSCAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_RX_OS_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_OS_RDY);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_1,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_D0 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_D1 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_E0);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_2,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_E1 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_EYE);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_8,
+			  AIROHA_PCS_PMA_FORCE_BLWC_RX_RST_B |
+			  AIROHA_PCS_PMA_FORCE_EYECNT_RX_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_7,
+			  AIROHA_PCS_PMA_DISB_BLWC_RX_RST_B |
+			  AIROHA_PCS_PMA_DISB_EYECNT_RX_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_EYEDUR_INIT_B |
+			  AIROHA_PCS_PMA_DISB_EYEDUR_INIT_B |
+			  AIROHA_PCS_PMA_FORCE_EYEDUR_EN |
+			  AIROHA_PCS_PMA_DISB_EYEDUR_EN);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_RX_PDOS_CTRL_0,
+			   AIROHA_PCS_PMA_SAP_SEL,
+			   AIROHA_PCS_PMA_SAP_SEL_SHIFT_8);
+
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			  AIROHA_PCS_PMA_FORCE_PDOS_RX_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_6,
+			  AIROHA_PCS_PMA_DISB_PDOS_RX_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_RESET_1,
+			  AIROHA_PCS_PMA_PDOS_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_PDOS_EN |
+			  AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_0,
+			  AIROHA_PCS_PMA_DISB_RX_PDOS_EN |
+			  AIROHA_PCS_PMA_DISB_RX_OS_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_7,
+			AIROHA_PCS_PMA_FORCE_PDOS_RX_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_RESET_1,
+			AIROHA_PCS_PMA_PDOS_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			AIROHA_PCS_PMA_FORCE_RX_PDOS_EN);
+	udelay(200);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_PDOS_EN |
+			  AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+
+	/* Return eye control to hardware and release forced PDOSCAL after calibration. */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_EYE_TOP_EYECNT_CTRL_1,
+			AIROHA_PCS_PMA_DISB_EYEDUR_INIT_B |
+			AIROHA_PCS_PMA_DISB_EYEDUR_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_7,
+			AIROHA_PCS_PMA_DISB_EYECNT_RX_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_1,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_D0 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_D1 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_E0);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_2,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_E1 |
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_DAC_EYE);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_RX_FE_PWDB,
+			  AIROHA_PCS_PMA_FORCE_DA_RX_PDOSCAL_EN);
+}
+
+static void an7581_pcs_pon_feos(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_RX_OS_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_OS_RDY);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_2,
+			AIROHA_PCS_PMA_DISB_DA_XPON_RX_FE_VOS);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_8,
+			  AIROHA_PCS_PMA_FORCE_BLWC_RX_RST_B |
+			  AIROHA_PCS_PMA_FORCE_FEOS_RX_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_7,
+			  AIROHA_PCS_PMA_DISB_BLWC_RX_RST_B |
+			  AIROHA_PCS_PMA_DISB_FEOS_RX_RST_B);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_SS_RX_FEOS,
+			   AIROHA_PCS_PMA_LFSEL,
+			   FIELD_PREP(AIROHA_PCS_PMA_LFSEL, 0x30));
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			  AIROHA_PCS_PMA_FEOS_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_FEOS_EN |
+			  AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_0,
+			  AIROHA_PCS_PMA_DISB_RX_FEOS_EN |
+			  AIROHA_PCS_PMA_DISB_RX_OS_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_8,
+			AIROHA_PCS_PMA_FORCE_FEOS_RX_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			AIROHA_PCS_PMA_FEOS_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			AIROHA_PCS_PMA_FORCE_RX_FEOS_EN);
+	udelay(200);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_0,
+			  AIROHA_PCS_PMA_FORCE_RX_FEOS_EN |
+			  AIROHA_PCS_PMA_FORCE_RX_OS_EN);
+}
+
+static void an7581_pcs_pon_sdcal(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_RX_SIGDET_CAL_EN,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_SIGDET_CAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_RX_SIGDET_CAL_EN,
+			  AIROHA_PCS_PMA_FORCE_DA_RX_SIGDET_CAL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_PXP_RX_OSCAL_EN,
+			AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_EN |
+			AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			  AIROHA_PCS_PMA_CAL_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_8,
+			  AIROHA_PCS_PMA_FORCE_SDCAL_REF_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_DISB_MODE_7,
+			  AIROHA_PCS_PMA_DISB_SDCAL_REF_RST_B);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_SDCAL_EN);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_RX_SDCAL_EN);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_RESET_0,
+			AIROHA_PCS_PMA_CAL_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_FORCE_MODE_8,
+			AIROHA_PCS_PMA_FORCE_SDCAL_REF_RST_B);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			AIROHA_PCS_PMA_FORCE_RX_SDCAL_EN);
+	udelay(200);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			  AIROHA_PCS_PMA_FORCE_RX_SDCAL_EN);
+
+	/* Disable the OSCAL clock and forced reset after SDCal stabilizes eye scan. */
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_PXP_RX_SIGDET_CAL_EN,
+			  AIROHA_PCS_PMA_FORCE_DA_RX_SIGDET_CAL_EN);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_JCPLL_SDM_SCAN_RSTB,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_CKON |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_CKON,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_CKON);
+	regmap_update_bits(pma, AIROHA_PCS_PMA_PXP_RX_OSCAL_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_RSTB |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_RSTB |
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_EN |
+			   AIROHA_PCS_PMA_FORCE_DA_RX_OSCAL_EN,
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_RSTB |
+			   AIROHA_PCS_PMA_FORCE_SEL_DA_RX_OSCAL_EN);
+}
+
+static void an7581_pcs_pon_phy_status(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+
+	/* This gate reports analog calibration; PHYA_READY reports digital PHY state. */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_FORCE_CTRL_1,
+			AIROHA_PCS_PMA_FORCE_RX_OS_RDY);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_RX_CTRL_SEQUENCE_DISB_CTRL_1,
+			  AIROHA_PCS_PMA_DISB_RX_OS_RDY);
+	udelay(1);
+}
+
+static void an7581_pcs_pon_full_reset(struct airoha_pcs_priv *priv, int index)
+{
+	struct regmap *pma = priv->pcs_pma[index];
+	u32 mask = GENMASK(11, 0);
+
+	/*
+	 * XPON_DIG_reset() pulses SW_RST_SET[11:0] while preserving the XFI MAC
+	 * reset bits 16 and 17 before RX FIFO handoff.
+	 */
+	regmap_set_bits(pma, AIROHA_PCS_PMA_SS_LCPLL_PWCTL_SETTING_0,
+			AIROHA_PCS_PMA_SW_LCPLL_EN);
+	udelay(100);
+	regmap_clear_bits(pma, AIROHA_PCS_PMA_SW_RST_SET, mask);
+	udelay(10);
+	regmap_set_bits(pma, AIROHA_PCS_PMA_SW_RST_SET, mask);
+}
