From 508871a478d49d7409cfbf0c63f56bc6a4c280cd Mon Sep 17 00:00:00 2001
From: pbs05 <27010143+pbs05@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:18:22 +0800
Subject: [PATCH 7/9] net: airoha: bound NPU mailbox wait time

Rebased from patches-6.18 onto linux-7.3.1 + patches-7.3; applies cleanly.

Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>

Signed-off-by: lean <chenlin@fnnas.com>

Signed-off-by: rea-analysis <rea-analysis@local>
---
 drivers/net/ethernet/airoha/airoha_npu.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/airoha/airoha_npu.c b/drivers/net/ethernet/airoha/airoha_npu.c
index 6a6a6a623..bfb699ac4 100644
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -30,6 +30,7 @@
  * is 16 bytes (INODE_TXRX_REG_ADDR). Keep headroom for future commands.
  */
 #define AIROHA_NPU_MBOX_SIZE			256
+#define AIROHA_NPU_MBOX_TIMEOUT_US		(100 * USEC_PER_MSEC)
 
 #define REG_NPU_LOCAL_SRAM		0x0
 
@@ -203,7 +204,7 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 	ret = regmap_read_poll_timeout_atomic(npu->regmap,
 					      REG_CR_MBQ0_CTRL(3) + offset,
 					      val, (val & MBOX_MSG_DONE),
-					      100, 100 * MSEC_PER_SEC);
+					      100, AIROHA_NPU_MBOX_TIMEOUT_US);
 	if (!ret && FIELD_GET(MBOX_MSG_STATUS, val) != NPU_MBOX_SUCCESS)
 		ret = -EINVAL;
 
@@ -213,6 +214,11 @@ static int __airoha_npu_send_msg(struct airoha_npu *npu, int func_id,
 
 	spin_unlock_bh(&core->lock);
 
+	if (ret == -ETIMEDOUT)
+		dev_err_ratelimited(npu->dev,
+				    "mailbox function %d timed out\n",
+				    func_id);
+
 	return ret;
 }
 
