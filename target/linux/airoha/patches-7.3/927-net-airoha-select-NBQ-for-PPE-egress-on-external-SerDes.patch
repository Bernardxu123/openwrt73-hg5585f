From 6b2407d24f483f8e713b8e559bc1b23f4c0c73ea Mon Sep 17 00:00:00 2001
From: pbs05 <27010143+pbs05@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:18:22 +0800
Subject: [PATCH 8/9] net: airoha: select NBQ for PPE egress on external SerDes

Rebased from patches-6.18 onto linux-7.3.1 + patches-7.3; applies cleanly on top of the PON PPE offload metadata (925).

Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>

Signed-off-by: lean <chenlin@fnnas.com>

Signed-off-by: rea-analysis <rea-analysis@local>
---
 drivers/net/ethernet/airoha/airoha_ppe.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/net/ethernet/airoha/airoha_ppe.c b/drivers/net/ethernet/airoha/airoha_ppe.c
index 51dda9de6..2d625b97e 100644
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -512,6 +512,10 @@ static int airoha_ppe_foe_entry_prepare(struct airoha_eth *eth,
 			 */
 			if (airoha_is_lan_gdm_dev(dev))
 				val |= AIROHA_FOE_IB2_FAST_PATH;
+			/* GDM3/GDM4 select their external SerDes through NBQ. */
+			if (pse_port == FE_PSE_PORT_GDM3 ||
+			    pse_port == FE_PSE_PORT_GDM4)
+				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, dev->nbq);
 			if (dsa_port >= 0)
 				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ,
 						  dsa_port);
-- 
