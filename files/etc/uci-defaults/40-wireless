#!/bin/sh
# First-boot wireless defaults.
#
# Nothing identifying is baked into this repository: the SSIDs and the WPA
# key are read from /etc/wireless-cfg (mode 0600), provisioned at flash time:
#
#   WIFI_PSK=...
#   WIFI_SSID_2G=...
#   WIFI_SSID_5G=...
#
# Without that file the radios stay disabled instead of shipping a known
# password or a public SSID name.

. /lib/functions.sh

[ -f /etc/wireless-cfg ] || {
	logger -t uci-defaults "40-wireless: /etc/wireless-cfg missing, keeping radios disabled"
	exit 0
}

. /etc/wireless-cfg

[ -n "$WIFI_PSK" ] || exit 0
ssid2g=${WIFI_SSID_2G:-HG5585F}
ssid5g=${WIFI_SSID_5G:-HG5585F_5G}

apply_radio() {
	local radio="$1" band="$2" channel="$3" htmode="$4" ssid="$5"

	uci -q set wireless.${radio}.disabled='0'
	uci -q set wireless.${radio}.country='CN'
	uci -q set wireless.${radio}.channel="$channel"
	uci -q set wireless.${radio}.htmode="$htmode"
	uci -q set wireless.${radio}.band="$band"
	# mt76 has no vendor dbdc k/v tuning; 802.11k/v are the standard
	# equivalents of the RRM switches QWRT sets in its mtwifi profile.
	uci -q set wireless.${radio}.ieee80211k='1'
	uci -q set wireless.${radio}.ieee80211v='1'

	uci -q set wireless.default_${radio}.disabled='0'
	uci -q set wireless.default_${radio}.mode='ap'
	uci -q set wireless.default_${radio}.network='lan'
	uci -q set wireless.default_${radio}.ssid="$ssid"
	uci -q set wireless.default_${radio}.encryption='psk2'
	uci -q set wireless.default_${radio}.key="$WIFI_PSK"
}

apply_radio radio0 2g 11 HE20 "$ssid2g"
apply_radio radio1 5g 36 HE160 "$ssid5g"

uci -q commit wireless
exit 0
