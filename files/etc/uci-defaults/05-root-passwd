#!/bin/sh
# Root password, provisioned instead of shipped.
#
# The image used to carry /etc/shadow with a real hash. This repository is
# public, so that hash was published; it is no longer part of the image.
# Write the password to /etc/root-password (mode 0600) before the
# first boot that should apply it, for example through the sysupgrade keep
# list or by hand after flashing. Without the file the root password
# stays whatever the running system already had.

[ -f /etc/root-password ] || exit 0

rootpw=$(head -n 1 /etc/root-password 2>/dev/null)
[ -n "$rootpw" ] || exit 0

printf '%s\n%s\n' "$rootpw" "$rootpw" | passwd root >/dev/null 2>&1
chmod 0600 /etc/root-password 2>/dev/null
exit 0
