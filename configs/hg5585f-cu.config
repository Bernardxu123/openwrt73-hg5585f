# HG5585F CU (kernel 7.3.1)
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=y
CONFIG_TARGET_airoha_an7581_DEVICE_fiberhome_hg5585f-cu=y
CONFIG_TESTING_KERNEL=y
# L3: honk (eBPF CO-RE) requirements
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES is not set
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_PROBE_EVENTS_BTF_ARGS=y
# NAT1 (kmod-nft-fullcone) and the software-offload A/B need these in-kernel;
# the generic config ships them unset, so force them through the KERNEL_
# overrides which are applied after the generic/target merge.
CONFIG_KERNEL_NF_CONNTRACK_EVENTS=y
CONFIG_KERNEL_NF_CONNTRACK_CHAIN_EVENTS=y
CONFIG_KERNEL_NF_FLOW_TABLE=m
CONFIG_KERNEL_NF_FLOW_TABLE_INET=m
CONFIG_KERNEL_NFT_FLOW_OFFLOAD=m
